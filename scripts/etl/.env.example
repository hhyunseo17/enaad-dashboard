SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Management API (SQL 직접 실행용) — https://supabase.com/dashboard/account/tokens 에서 발급
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token-here
SUPABASE_PROJECT_REF=xxxxxxxx

# provision-auth-users.mjs 전용 — name.xlsx 명단 전원에게 부여할 공통 초기 비밀번호(로그인 후 개인별 교체 유도)
PROVISION_INITIAL_PASSWORD=change-me-before-running
